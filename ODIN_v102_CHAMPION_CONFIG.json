        "S12_cmc_risk >= -0.05",
        "P3_publication_volume <= -0.08",
        "S6_hiring_void == True",
        "S22_pediatric_pk_risk == True"
      ],
      "notes": "Prevent crowd optimism from overriding objective red flags. If any cap_trigger fires, max S21 = 0.02"
    },

    "S22_pediatric_pk_risk": {
      "name": "Pediatric PK Bridging Risk",
      "version": "1.0",
      "changelog": "NEW - Created from PHAR CRL failure",
      "trigger_conditions": {
        "submission_type": ["sNDA_PEDIATRIC", "BLA_SUPPLEMENT_PEDIATRIC"],
        "dosing_type": ["weight_based", "age_tiered"],
        "pediatric_pk_published": false
      },
      "penalty": -0.10,
      "notes": "If ALL conditions met: pediatric submission + weight-based dosing + no published PK study = HIGH RISK. FDA consistently requests additional PK data when extrapolating from adults."
    },

    "P3_publication_volume": {
      "name": "Publication Volume Signal",
      "version": "2.0",
      "changelog": "PHAR fix: Additional penalty for unpublished pivotal data",
      "thresholds": {
