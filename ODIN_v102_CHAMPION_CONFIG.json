        "low": 25,
        "adequate": 50
      },
      "adjustments": {
        "very_low_penalty": -0.08,
        "low_penalty": -0.04,
        "adequate": 0.0,
        "high_boost": 0.02
      },
      "unpublished_data_penalty": -0.05,
      "notes": "If pivotal trial data only in press release (not peer-reviewed), add -0.05. PHAR had no published pediatric PK."
    }
