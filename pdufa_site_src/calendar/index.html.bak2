burger span::after{position:absolute;top:6px}body.pd-navopen .pd-burger span{background:transparent}body.pd-navopen .pd-burger span::before{top:0;transform:rotate(45deg)}body.pd-navopen .pd-burger span::after{top:0;transform:rotate(-45deg)}@media(max-width:720px){.pd-burger{display:inline-flex}.hd nav,.top .nav{position:fixed;inset:56px 0 auto 0;z-index:30;flex-direction:column;align-items:stretch;gap:0;background:#0b1626;border-bottom:1px solid #1e3a63;box-shadow:0 18px 40px rgba(0,0,0,.5);max-height:0;overflow:hidden;transition:max-height .25s ease}body.pd-navopen .hd nav,body.pd-navopen .top .nav{max-height:82vh;overflow:auto}.hd nav a,.top .nav a{padding:15px 20px!important;border-bottom:1px solid #14263f;font-size:16px!important;border-radius:0!important;min-height:44px;display:flex;align-items:center}.chip{min-height:40px}}.navdd{position:relative;display:inline-flex;align-items:center}.navddb{background:transparent;border:0;color:inherit;font:inherit;cursor:pointer;padding:7px 11px;border-radius:8px;display:inline-flex;align-items:center;gap:3px}.navdd:hover .navddb,.navdd:focus-within .navddb{color:#eef4fc}.navddm{position:absolute;top:100%;right:0;min-width:170px;background:#0b1626;border:1px solid #294d80;border-radius:12px;box-shadow:0 16px 40px rgba(0,0,0,.5);padding:6px;flex-direction:column;display:none;z-index:40}.navdd:hover .navddm,.navdd:focus-within .navddm{display:flex}.navddm a{padding:9px 12px!important;border-radius:8px;white-space:nowrap}.navddm a:hover{background:#132745}@media(max-width:720px){.navdd{display:contents}.navddb{display:none}.navddm{position:static;display:flex!important;min-width:0;background:transparent;border:0;box-shadow:none;padding:0}.navddm a{border-bottom:1px solid #14263f}}</style></head><body><header class="site"><div class="hd"><a class="brand" href="/"><svg class="lm" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" style="flex:none;vertical-align:-4px;margin-right:7px"><rect x="1" y="1" width="22" heig