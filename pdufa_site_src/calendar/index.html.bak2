/PHAR","startDate":"2026-10-24"}},{"@type":"ListItem","position":30,"item":{"@type":"Event","name":"INO \u2014 INO-3107","url":"https://www.pdufa.bio/pdufa/INO","startDate":"2026-10-30"}},{"@type":"ListItem","position":31,"item":{"@type":"Event","name":"BTAI \u2014 IGALMI\u00ae\u202f(dexmedetomidine)","url":"https://www.pdufa.bio/pdufa/BTAI","startDate":"2026-11-14"}},{"@type":"ListItem","position":32,"item":{"@type":"Event","name":"SMMT \u2014 Ivonescimab plus platinum-doublet\u2026","url":"https://www.pdufa.bio/pdufa/SMMT","startDate":"2026-11-14"}},{"@type":"ListItem","position":33,"item":{"@type":"Event","name":"SVRA \u2014 MOLBREEVI (Molgradex)","url":"https://www.pdufa.bio/pdufa/SVRA","startDate":"2026-11-22"}},{"@type":"ListItem","position":34,"item":{"@type":"Event","name":"BBIO \u2014 BBP-418","url":"https://www.pdufa.bio/pdufa/BBIO","startDate":"2026-11-27"}},{"@type":"ListItem","position":35,"item":{"@type":"Event","name":"NUVL \u2014 Neladalkib (NVL-655)","url":"https://www.pdufa.bio/pdufa/NUVL-neladalkib","startDate":"2026-11-27"}},{"@type":"ListItem","position":36,"item":{"@type":"Event","name":"VRTX \u2014 Povetacicept (ALPN-303)","url":"https://www.pdufa.bio/pdufa/VRTX","startDate":"2026-11-30"}},{"@type":"ListItem","position":37,"item":{"@type":"Event","name":"RHHBY \u2014 Giredestrant","url":"https://www.pdufa.bio/pdufa/RHHBY-giredestrant","startDate":"2026-11-30"}},{"@type":"ListItem","position":38,"item":{"@type":"Event","name":"BAYRY \u2014 HYRNUO (sevabertinib)","url":"https://www.pdufa.bio/pdufa/BAYRY-hyrnuo","startDate":"2026-11-30"}},{"@type":"ListItem","position":39,"item":{"@type":"Event","name":"EXEL \u2014 XL092 with atezolizumab","url":"https://www.pdufa.bio/pdufa/EXEL","startDate":"2026-12-03"}},{"@type":"ListItem","position":40,"item":{"@type":"Event","name":"ANAB / VNDA \u2014 Imsidolimab (ANB019)","url":"https://www.pdufa.bio/pdufa/VNDA","startDate":"2026-12-12"}},{"@type":"ListItem","position":41,"item":{"@type":"Event","name":"RHH