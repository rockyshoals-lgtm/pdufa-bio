  "scoring_function": {
    "description": "logit = intercept + sum(coef[i] * (feature[i] - mean[i]) / scale[i]); prob = sigmoid(logit)",
    "steps": [
      "1. Extract 11 features from event data",
      "2. Standardize each feature: z = (x - mean) / scale",
      "3. Compute logit: intercept + sum(coef * z)",
      "4. Convert to probability: P = 1 / (1 + exp(-logit))",
      "5. Assign tier based on probability thresholds"
    ]
  },
