  "strategies": [
    {
      "name": "Strategy 1: Momentum Runup Trade (Primary)",
      "setup": {
        "entry_window_days_before_pdufa": [
          60,
          45
        ],
        "target_return": "8–15% median; outliers >100%",
        "instruments": [
          "long equity",
          "ITM/ATM calls (2–3 month expiry)"
        ]
      },
      "entry_criteria": "Require ≥4 of 6 (see best_entry_exit_windows.primary_entry_window.entry_criteria_require_at_least_4_of_6).",
      "exit_rules": {
        "primary_exit": {
          "days_before_pdufa": [
            10,
            7
          ],
          "rule": "Exit regardless of P/L."
        },
        "early_exit_triggers": [
          {
            "trigger": "20% gain achieved",
            "action": "Sell 50% of position"
          },
          {
            "trigger": "Negative news (manufacturing delay, RTOR issues)",
            "action": "Exit immediately"
          },
          {
            "trigger": "Competitor approval in same indication",
            "action": "Reassess within 24h"
          }
        ],
        "stop_loss": {
          "pct_from_entry": 15,
          "note": "Accept as cost of binary exposure; binary catalysts make tight stops impractical."
        }
      },
      "position_sizing": {
        "max_pct_portfolio": 5,
        "recommended_pct_portfolio": "2–3% for newer traders",
        "portfolio_construction": "Basket of 8–12 positions across different dates"
      }
    },
    {
      "name": "Strategy 2: Vol-Expansion Straddle (ODIN Specialty)",
      "theory": "IV tends to expand materially from ~T-45 to ~T-1; capture IV expansion and exit before IV crush.",
      "volatility_cycle": [
        {
          "phase": 1,
          "window_days_before_pdufa": [
            60,
            45
          ],
          "description": "IV below ~30th percentile; BUY"
        },
        {
          "phase": 2,
          "window_days_before_pdufa": [
            45,
            20
          ],
          "description": "IV expansion begins; HOLD"
        },
        {
          "phase": 3,
          "window_days_before_pdufa": [
            20,
            7
          ],
          "description": "IV acceleration/peak pricing; SELL WINDOW"
        },
        {
          "phase": 4,
          "window_days_before_pdufa": [
            7,
            -1
          ],
          "description": "Max IV then crush; DO NOT HOLD"
        }
      ],
      "execution": {
        "entry": "Buy ATM straddle when 30-day IV < 60% (or <30th percentile historically for ticker).",
        "target": "IV doubles; ~70–150% straddle gain typical in expansion phase.",
        "exit": "Exit T-10 to T-7 regardless of stock direction.",
        "risk": "If IV doesn't expand, max loss is premium paid."
      },
      "position_sizing": {
        "max_pct_portfolio": 3,
        "stop_loss_pct": 20
      }
    },
    {
      "name": "Strategy 3: CRL Early Warning Short (Advanced)",
      "multi_signal_framework": {
        "rule": "Require ≥3 of 5 red flags before initiating short.",
        "signals": [
          {
            "signal": "IV term spread inverted (30d IV > 90d IV)",
            "weight": 0.25
          },
          {
            "signal": "Discretionary insider sales ratio >0.6",
            "weight": 0.25
          },
          {
            "signal": "Late sales cluster (>50% in final 14 days)",
            "weight": 0.2
          },
          {
            "signal": "Price peaked ~T-15 and declining into PDUFA",
            "weight": 0.15
          },
          {
            "signal": "Negative SSOF (signed small order flow)",
            "weight": 0.15
          }
        ]
      },
      "execution": {
        "entry_window_days_before_pdufa": [
          7,
          3
        ],
        "instruments": [
          "short equity",
          "buy puts",
          "sell call spreads"
        ],
        "target_return": "15–25% (typical CRL gap -30% to -50%)",
        "exit": "Day before PDUFA or upon early FDA announcement",
        "position_size_max_pct_portfolio": 2
      },
      "risk_controls": [
        "Never short strong designation stacks (BTD+Orphan+Priority).",
        "Never short Class 1 resubmissions.",
        "Accept possibility of full loss if approval occurs."
      ]
    },
    {
      "name": "Strategy 4: Resubmission Recovery (Post-CRL)",
      "setup": [
        "After CMC/manufacturing-only CRL (NOT efficacy failure): wait for timeline clarity.",
        "Enter when resubmission is accepted (often after -40% to -60% drop).",
        "Target recovery toward 70–80% of pre-CRL level.",
        "Exit T-10 before resubmission PDUFA."
      ],
      "qualification_criteria": [
        "CRL explicitly cites CMC/manufacturing issues only.",
        "No efficacy or safety concerns in CRL rationale.",
        "Financial runway >18 months.",
        "Experienced sponsor (previous approvals)."
      ],
      "position_sizing": {
        "max_pct_portfolio": 5,
        "note": "Higher conviction than initial PDUFA but longer holding period implies more volatility exposure."
      }
    }
