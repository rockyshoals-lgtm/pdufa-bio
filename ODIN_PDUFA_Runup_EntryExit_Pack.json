          "rationale": "No exit opportunity after announcement; gap risk into Monday."
        },
        {
          "scenario": "Pediatric sNDA",
          "exit_rule": "Exit T-10, 0% runner",
          "rationale": "Dosing/PK bridging risk + label expansion nuance."
        },
        {
          "scenario": "Any CMC delay mention (FDA/EMA/other)",
          "exit_rule": "Immediate exit / do not enter",
          "rationale": "Historically 2–5× higher CRL probability."
        },
        {
          "scenario": "EMA concerns disclosed (CMC LoQ, extensions)",
          "exit_rule": "Immediate exit / avoid",
          "rationale": "Cross-regulatory CMC flags often precede FDA issues."
        },
        {
          "scenario": "Hiring void (<3 meaningful commercial hires) on NDA/BLA",
          "exit_rule": "Exit T-10 (or avoid)",
          "rationale": "Potential sponsor caution / low confidence signal."
