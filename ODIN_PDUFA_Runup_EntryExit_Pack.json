  "core_thesis": {
    "one_liner": "Most profit is captured in the pre-decision runup; the FDA decision itself is an unhedgeable binary gap risk.",
    "cardinal_rule": "Never hold through the FDA decision. The runup IS the trade.",
    "why": [
      "By ~T-5 you typically capture ~80–90% of the runup while taking ~0% of the binary event risk.",
      "Post-decision outcomes often include IV crush, 'sell-the-news' behavior, or catastrophic gap downs on CRL.",
      "Weekend action dates can remove the ability to exit after announcements."
    ]
  },
  "definitions": {
    "T_minus_N": "N trading days before the PDUFA action date (T-0).",
    "PDUFA": "FDA target action date for NDA/BLA/sNDA/sBLA decisions.",
    "IV": "Implied volatility; tends to expand into binary catalysts and collapse after.",
    "runup": "Price/IV appreciation into the catalyst date due to positioning, momentum, and uncertainty premium."
  },
  "best_entry_exit_windows": {
    "primary_entry_window": {
      "days_before_pdufa": [
        60,
        45
      ],
      "why": [
        "PDUFA date is usually confirmed and institutional positioning begins.",
        "Implied volatility is often lower (better risk/reward for calls/straddles).",
        "Avoids late-cycle retail FOMO and elevated option premiums."
      ],
      "entry_criteria_require_at_least_4_of_6": [
        {
          "id": 1,
          "criterion": "PDUFA date officially confirmed",
          "source": "FDA/company press release"
        },
        {
          "id": 2,
          "criterion": "Market cap $100M–$2B (sweet spot)",
          "source": "market data"
        },
        {
          "id": 3,
          "criterion": "Binary outcome is NDA/BLA (not sNDA)",
          "source": "filing type"
        },
        {
          "id": 4,
          "criterion": "Prior positive Phase 3 data",
          "source": "press release/publication"
        },
        {
          "id": 5,
          "criterion": "No prior CRL OR prior efficacy CRL clearly addressed",
          "source": "FDA history"
        },
        {
          "id": 6,
          "criterion": "Options liquidity exists (≥500 OI near the money)",
          "source": "options chain"
        }
      ],
      "late_entry_window_if_missed": {
        "days_before_pdufa": [
          30,
          20
        ],
        "note": "This is a 'late but still workable' entry window used in the T-5 protocol checklist; avoid chasing after T-30 if IV is already elevated."
      }
    },
    "exit_window_default": {
      "days_before_pdufa": [
        10,
        7
      ],
      "rule": "Close positions within T-10 to T-7 as the default conservative policy (especially for options/IV trades).",
      "notes": [
        "Exit before IV peak and before the highest-risk binary window.",
        "Do not hold through T-7 to T-0."
      ]
    },
